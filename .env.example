# ==============================================================
# Configuration d'environnement pour l'Agent d'Assurance
# ==============================================================

# Clés API IA & LLM (Optionnelles ou recommandées pour les fonctionnalités intelligentes)
OPENAI_API_KEY=sk-proj-votre_cle_openai_ici
GOOGLE_API_KEY=votre_cle_gemini_ici
TAVILY_API_KEY=tvly-votre_cle_tavily_ici

# Cominty Managed Agents
COMINTY_API_KEY=
COMINTY_USER_ID=
# Les IDs peuvent rester vides : quatre agents seront créés automatiquement.
COMINTY_AGENT_EXTRACTION_ID=
COMINTY_AGENT_ANOMALIES_ID=
COMINTY_AGENT_RISK_ID=
COMINTY_AGENT_REPORT_ID=

# Configuration Base de données MySQL
# (En local: localhost | En Docker: db)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=assurance_db
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=rootpassword

# Configuration Sécurité & JWT
JWT_SECRET=super_secret_jwt_assurance_key_2026

# Notifications Email SMTP (Gmail App Password)
EMAIL_SENDER=votre.email@gmail.com
EMAIL_PASSWORD=votre_mot_de_passe_application_smtp
TEAMS_WEBHOOK_URL=

# Mode Test (1 pour mock JSON, 0 pour production MySQL)
TESTING=0
